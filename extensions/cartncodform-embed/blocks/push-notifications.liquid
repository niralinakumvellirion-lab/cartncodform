{% if block.settings.enable_push %}
<div id="ccf-embed-root" data-product-title="{{ product.title | escape }}" style="display:none"></div>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js" defer></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-messaging-compat.js" defer></script>
<script src="{{ 'ccf-push.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "ShopiReachBoost AI Push",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_push",
      "label": "Enable Push Notifications",
      "default": true
    }
  ]
}
{% endschema %}
