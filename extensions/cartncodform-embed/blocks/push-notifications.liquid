{% if block.settings.enable_push %}
<script>
(function() {
  'use strict';

  var BACKEND_URL = 'https://cartncodform-backend.onrender.com';

  // App Proxy URL - serves SW from same origin as store
  var PROXY_SW_URL = window.location.origin + '/apps/cartncodform/sw.js';

  var VAPID_KEY = 'BMPrLf4eInbFu1IpI_ZqyblmkbSYIm0JyukselN80lglfwuBfyaU7kOQZ6FFxo1PjUqh1xnGzd2uVPdJrYEh0Jo';

  var firebaseConfig = {
    apiKey: "AIzaSyASPGdEC4K_acNQYY7AeQvskDQ5Xq4-ecU",
    projectId: "cartncodform",
    messagingSenderId: "133172185047",
    appId: "1:133172185047:web:23be3ca1f3ccf357a62d92",
    authDomain: "cartncodform.firebaseapp.com",
    storageBucket: "cartncodform.appspot.com",
  };

  var SHOP_DOMAIN = window.Shopify && window.Shopify.shop
    ? window.Shopify.shop
    : window.location.hostname;

  var TOKEN_KEY = 'ccf_fcm_token_' + SHOP_DOMAIN;
  var SUBSCRIBED_KEY = 'ccf_subscribed_' + SHOP_DOMAIN;

  console.log('[CCF] Shop:', SHOP_DOMAIN);
  console.log('[CCF] SW URL:', PROXY_SW_URL);

  // ============================================
  // POPUP HTML + CSS (injected dynamically)
  // ============================================

  function injectStyles() {
    if (document.getElementById('ccf-styles')) return;
    var style = document.createElement('style');
    style.id = 'ccf-styles';
    style.textContent = [
      '#ccf-overlay{display:none;position:fixed;top:0;left:0;right:0;bottom:0;',
      'background:rgba(0,0,0,0.65);z-index:2147483647;',
      'align-items:center;justify-content:center;font-family:-apple-system,sans-serif;}',
      '#ccf-card{background:#fff;border-radius:20px;padding:28px 24px;',
      'max-width:340px;width:90%;text-align:center;position:relative;}',
      '#ccf-close{position:absolute;top:12px;right:14px;background:none;',
      'border:none;font-size:20px;cursor:pointer;color:#999;line-height:1;}',
      '#ccf-timer-badge{position:absolute;top:12px;left:14px;background:#f0f0f0;',
      'border-radius:20px;padding:2px 10px;font-size:11px;color:#666;font-weight:600;}',
      '#ccf-emoji{font-size:48px;display:block;margin:16px 0 10px;}',
      '#ccf-badge{background:#fee2e2;color:#dc2626;font-size:10px;font-weight:700;',
      'padding:3px 12px;border-radius:20px;display:inline-block;margin-bottom:12px;',
      'text-transform:uppercase;letter-spacing:0.5px;}',
      '#ccf-discount{background:#dcfce7;color:#166534;border-radius:10px;',
      'padding:10px;margin-bottom:14px;font-size:14px;font-weight:600;}',
      '#ccf-title{font-size:20px;font-weight:700;color:#111;margin:0 0 8px;line-height:1.3;}',
      '#ccf-desc{font-size:13px;color:#666;margin:0 0 14px;line-height:1.6;}',
      '#ccf-benefits{background:#f8f9ff;border-radius:10px;padding:12px;',
      'margin-bottom:16px;text-align:left;}',
      '#ccf-benefits div{font-size:12px;color:#444;padding:3px 0;}',
      '#ccf-yes{width:100%;background:linear-gradient(135deg,#667eea,#764ba2);',
      'color:#fff;border:none;border-radius:12px;padding:15px;font-size:15px;',
      'font-weight:700;cursor:pointer;margin-bottom:8px;display:block;}',
      '#ccf-no{background:none;border:none;color:#aaa;font-size:12px;',
      'cursor:pointer;text-decoration:underline;padding:4px;}'
    ].join('');
    (document.head || document.documentElement).appendChild(style);
  }

  function injectHTML() {
    if (document.getElementById('ccf-overlay')) return;
    var div = document.createElement('div');
    div.id = 'ccf-overlay';
    div.setAttribute('role', 'dialog');
    div.innerHTML = [
      '<div id="ccf-card">',
        '<button id="ccf-close">&times;</button>',
        '<div id="ccf-timer-badge">&#9201; <span id="ccf-count">15</span>s</div>',
        '<span id="ccf-emoji">&#128276;</span>',
        '<div id="ccf-badge">{{ block.settings.popup_badge }}</div>',
        '<div id="ccf-discount">&#127873; {{ block.settings.discount_text }}</div>',
        '<h2 id="ccf-title">{{ block.settings.popup_title }}</h2>',
        '<p id="ccf-desc">{{ block.settings.popup_description }}</p>',
        '<div id="ccf-benefits">',
          '<div>&#9989; {{ block.settings.benefit_1 }}</div>',
          '<div>&#9989; {{ block.settings.benefit_2 }}</div>',
          '<div>&#9989; {{ block.settings.benefit_3 }}</div>',
        '</div>',
        '<button id="ccf-yes">&#128276; {{ block.settings.allow_button_text }}</button>',
        '<br>',
        '<button id="ccf-no">{{ block.settings.deny_button_text }}</button>',
      '</div>'
    ].join('');
    document.body.appendChild(div);
  }

  // ============================================
  // POPUP CONTROLS
  // ============================================

  var countdownTimer = null;

  function showPopup() {
    var o = document.getElementById('ccf-overlay');
    if (!o) return;
    o.style.display = 'flex';
    o.style.alignItems = 'center';
    o.style.justifyContent = 'center';
    console.log('[CCF] Popup shown');
    startCountdown();
  }

  function hidePopup() {
    var o = document.getElementById('ccf-overlay');
    if (o) o.style.display = 'none';
    if (countdownTimer) clearInterval(countdownTimer);
  }

  function startCountdown() {
    var count = 15;
    var el = document.getElementById('ccf-count');
    if (countdownTimer) clearInterval(countdownTimer);
    countdownTimer = setInterval(function() {
      count--;
      if (el) el.textContent = count;
      if (count <= 0) {
        clearInterval(countdownTimer);
        hidePopup();
      }
    }, 1000);
  }

  function wireButtons() {
    var yes = document.getElementById('ccf-yes');
    var no = document.getElementById('ccf-no');
    var close = document.getElementById('ccf-close');

    if (yes) yes.addEventListener('click', function() {
      hidePopup();
      handleAllow();
    });

    if (no) no.addEventListener('click', function() {
      hidePopup();
      sessionStorage.setItem('ccf_denied_session', '1');
    });

    if (close) close.addEventListener('click', function() {
      hidePopup();
    });
  }

  // ============================================
  // SERVICE WORKER via APP PROXY
  // ============================================

  function registerSW() {
    return new Promise(function(resolve, reject) {
      if (!('serviceWorker' in navigator)) {
        return reject(new Error('SW not supported'));
      }

      console.log('[CCF] Registering SW via App Proxy:', PROXY_SW_URL);

      navigator.serviceWorker.register(PROXY_SW_URL, {
        scope: '/apps/cartncodform/',
        updateViaCache: 'none'
      }).then(function(reg) {
        console.log('[CCF] SW registered, scope:', reg.scope);

        if (reg.installing) {
          reg.installing.addEventListener('statechange', function(e) {
            if (e.target.state === 'activated') {
              console.log('[CCF] SW activated');
              resolve(reg);
            }
          });
          setTimeout(function() { resolve(reg); }, 5000);
        } else {
          resolve(reg);
        }
      }).catch(function(err) {
        console.error('[CCF] SW registration failed:', err.message);
        reject(err);
      });
    });
  }

  // ============================================
  // FCM TOKEN GENERATION
  // ============================================

  function getToken(swReg) {
    return new Promise(function(resolve, reject) {
      Promise.all([
        import('https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js'),
        import('https://www.gstatic.com/firebasejs/10.12.0/firebase-messaging.js')
      ]).then(function(modules) {
        var initializeApp = modules[0].initializeApp;
        var getApps = modules[0].getApps;
        var getMessaging = modules[1].getMessaging;
        var getTokenFn = modules[1].getToken;

        var app = getApps().length === 0
          ? initializeApp(firebaseConfig)
          : getApps()[0];

        var messaging = getMessaging(app);

        return getTokenFn(messaging, {
          vapidKey: VAPID_KEY,
          serviceWorkerRegistration: swReg
        });
      }).then(function(token) {
        if (token) {
          console.log('[CCF] Token:', token.substring(0, 20) + '...');
          resolve(token);
        } else {
          reject(new Error('No token returned'));
        }
      }).catch(reject);
    });
  }

  function saveToken(token) {
    return fetch(BACKEND_URL + '/api/push/subscribe-customer', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        shopDomain: SHOP_DOMAIN,
        token: token,
        page: window.location.pathname
      })
    }).then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) {
        localStorage.setItem(TOKEN_KEY, token);
        localStorage.setItem(SUBSCRIBED_KEY, '1');
        console.log('[CCF] Token saved to backend');
      }
    });
  }

  // ============================================
  // HANDLE ALLOW BUTTON
  // ============================================

  function handleAllow() {
    Notification.requestPermission().then(function(permission) {
      console.log('[CCF] Permission:', permission);

      if (permission !== 'granted') {
        sessionStorage.setItem('ccf_denied_session', '1');
        return;
      }

      registerSW().then(function(swReg) {
        return navigator.serviceWorker.ready.then(function() {
          return getToken(swReg);
        });
      }).then(function(token) {
        return saveToken(token);
      }).then(function() {
        console.log('[CCF] Fully subscribed!');
      }).catch(function(err) {
        console.error('[CCF] Subscribe failed:', err.message);
      });
    });
  }

  // ============================================
  // CHECK TOKEN + INIT
  // ============================================

  function checkAndInit() {
    if (!('Notification' in window)) {
      console.log('[CCF] Notifications not supported');
      return;
    }

    console.log('[CCF] Permission:', Notification.permission);

    // Already denied by browser
    if (Notification.permission === 'denied') return;

    // Denied this session
    if (sessionStorage.getItem('ccf_denied_session')) return;

    // Check existing token
    var existingToken = localStorage.getItem(TOKEN_KEY);

    if (existingToken && Notification.permission === 'granted') {
      // Token exists - silently re-subscribe to refresh
      console.log('[CCF] Token exists, refreshing silently...');
      registerSW().then(function(swReg) {
        return navigator.serviceWorker.ready.then(function() {
          return getToken(swReg);
        });
      }).then(function(token) {
        if (token !== existingToken) {
          return saveToken(token);
        }
      }).catch(function(err) {
        console.log('[CCF] Silent refresh error:', err.message);
      });
      return;
    }

    // No token - show popup after delay
    var delay = {{ block.settings.popup_delay }} * 1000;
    console.log('[CCF] No token, showing popup in', delay/1000, 's');

    setTimeout(function() {
      showPopup();
    }, delay);
  }

  // ============================================
  // CART TRACKING
  // ============================================

  function trackCart() {
    document.addEventListener('click', function(e) {
      var btn = e.target.closest('[name="add"], .product-form__submit, [data-testid="add-to-cart"]');
      if (!btn) return;
      var form = btn.closest('form[action*="/cart"]');
      if (!form) return;

      console.log('[CCF] Cart add detected');

      var token = localStorage.getItem(TOKEN_KEY);
      if (token) {
        fetch(BACKEND_URL + '/api/push/cart-activity', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shopDomain: SHOP_DOMAIN,
            token: token,
            event: 'add_to_cart',
            url: window.location.href
          })
        }).catch(function(e) {
          console.log('[CCF] Cart track error:', e.message);
        });
      }

      // Show popup if not subscribed
      if (!localStorage.getItem(SUBSCRIBED_KEY) && Notification.permission === 'default') {
        showPopup();
      }
    });
  }

  // ============================================
  // START
  // ============================================

  function start() {
    console.log('[CCF] Starting...');
    injectStyles();
    injectHTML();
    wireButtons();
    trackCart();
    checkAndInit();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }

  window.addEventListener('load', function() {
    if (!document.getElementById('ccf-overlay')) start();
  });

  // Expose for testing
  window.ccfShow = showPopup;
  window.ccfHide = hidePopup;

})();
</script>
{% endif %}

{% schema %}
{
  "name": "CartnCodForm Push",
  "target": "body",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_push",
      "label": "Enable Push Notifications",
      "default": true
    },
    {
      "type": "text",
      "id": "popup_badge",
      "label": "Badge Text",
      "default": "Exclusive Members Only"
    },
    {
      "type": "text",
      "id": "popup_title",
      "label": "Popup Title",
      "default": "Never Miss a Deal Again!"
    },
    {
      "type": "textarea",
      "id": "popup_description",
      "label": "Description",
      "default": "Get instant alerts for flash sales, restocks, and exclusive offers!"
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount Text",
      "default": "Subscribe and get 10% OFF your next order!"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Flash sale alerts - first access"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "Back in stock notifications"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Exclusive discount codes"
    },
    {
      "type": "text",
      "id": "allow_button_text",
      "label": "Allow Button",
      "default": "Yes! Notify Me"
    },
    {
      "type": "text",
      "id": "deny_button_text",
      "label": "Deny Button",
      "default": "No thanks, I hate deals"
    },
    {
      "type": "range",
      "id": "popup_delay",
      "label": "Show popup after (seconds)",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 5
    }
  ]
}
{% endschema %}
