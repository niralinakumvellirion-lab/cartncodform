{% comment %}
  "Price drop" — a "Notify me if the price drops" button + panel on in-stock sizes. Settings come from the
  app at runtime (ccf-pricedrop.js, App Proxy /apps/cartncodform/price-drop). The price shown is for
  display only; the app reads the real price from Shopify. Push needs the "ShopiReachBoost AI Push"
  app embed on; email and WhatsApp work without it.
{% endcomment %}
{%- if product -%}
<div
  id="ccf-pd-root"
  data-shop="{{ shop.permanent_domain | escape }}"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-product-handle="{{ product.handle | escape }}"
  {%- if product.featured_image %} data-product-image="{{ product.featured_image | image_url: width: 300 }}"{% endif %}
  data-selected="{{ product.selected_or_first_available_variant.id }}"
  data-design-mode="{{ request.design_mode }}"
>
  <script type="application/json" class="ccf-pd-variants">[
    {%- for v in product.variants -%}
      {"id":{{ v.id }},"title":{{ v.title | json }},"available":{{ v.available }},"price":{{ v.price | money | strip_html | json }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]</script>
</div>
<script src="{{ 'ccf-pricedrop.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Price drop",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": []
}
{% endschema %}
