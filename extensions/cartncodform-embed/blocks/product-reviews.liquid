{%- if request.design_mode -%}
  <div style="border:2px dashed #d4d4d8;border-radius:12px;padding:24px;text-align:center;color:#71717a;font-size:13px;font-family:sans-serif;line-height:1.5;">
    <strong style="display:block;margin-bottom:4px;color:#18181b;">Product reviews</strong>
    ShopiReachBoost AI &mdash; customer reviews, the star summary and the review form appear here on the live product page.
  </div>
{%- else -%}
  <div
    class="ccf-rv"
    id="ccf-rv-{{ block.id }}"
    data-ccf-reviews
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle | escape }}"
    data-heading="{{ block.settings.heading | escape }}"
    style="--ccf-rv-accent: {{ block.settings.accent_color | default: '#111827' }}; --ccf-rv-star: {{ block.settings.star_color | default: '#f59e0b' }};"
  ></div>
  {{ 'ccf-reviews.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ccf-reviews.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#111827" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#f59e0b" }
  ]
}
{% endschema %}
