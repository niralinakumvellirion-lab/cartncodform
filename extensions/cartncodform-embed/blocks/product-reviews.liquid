{% comment %} The real widget is drawn in the theme editor too (it re-initialises on shopify:section:load). {% endcomment %}
<div
  class="ccf-rv"
  id="ccf-rv-{{ block.id }}"
  data-ccf-reviews
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle | escape }}"
  data-product-title="{{ product.title | escape }}"
  {%- if product.featured_image %} data-product-image="{{ product.featured_image | image_url: width: 120 }}"{% endif %}
  data-eyebrow="{{ block.settings.eyebrow | escape }}"
  data-heading="{{ block.settings.heading | escape }}"
  style="--ccf-rv-accent: {{ block.settings.accent_color | default: '#141414' }}; --ccf-rv-star: {{ block.settings.star_color | default: '#141414' }}; --ccf-rv-max: {{ block.settings.max_width | default: 1100 }}px;"
></div>
{{ 'ccf-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ccf-reviews.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product reviews",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above the heading", "default": "Customer reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers are saying" },
    { "type": "color", "id": "accent_color", "label": "Button color", "default": "#141414" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#141414" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "unit": "px", "min": 600, "max": 1400, "step": 50, "default": 1100 }
  ]
}
{% endschema %}
