{
  "name": "cartncodform-backend",
  "version": "1.0.0",
  "description": "Backend for CartnCodForm - multi-store Shopify abandoned cart + COD platform",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedData.js",
    "test:db": "node scripts/testConnection.js",
